FINRAG_DATA_DIR=./data
FINRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# excerpts works immediately; ollama enables generated, cited answers.
FINRAG_ANSWER_MODE=excerpts
FINRAG_OLLAMA_URL=http://localhost:11434
FINRAG_OLLAMA_MODEL=qwen2.5:3b
# pymupdf is lightweight; layout preserves more borderless financial tables (uv sync --extra layout).
FINRAG_PARSER=pymupdf
FINRAG_OCR_LANGUAGE=eng
FINRAG_MAX_UPLOAD_MB=50
FINRAG_MAX_PAGES=500
